<Project>
  <!--
    Propiedades comunes a todos los proyectos de la solución SE_HardwareInserter.
    Réplica de la convención usada en CadLinter/Directory.Build.props.
  -->

  <PropertyGroup>
    <!-- .NET Framework 4.8: máxima compatibilidad con interop COM de Solid Edge. -->
    <TargetFramework>net48</TargetFramework>

    <LangVersion>9</LangVersion>

    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>

    <!-- ABI COM estable durante toda la serie 1.x. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Cada restore genera o actualiza el lock file; el modo bloqueado se activará al estabilizar el grafo. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Permite compilar net48 de forma reproducible sin depender del targeting pack del equipo. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" PrivateAssets="all" />
  </ItemGroup>

</Project>
